# =============================================================================
# SUPER GENIUS BOT — VPS config
# Copy this file to `.env` (same folder) and edit. The server reads `.env` on
# startup. `cp env.example .env`
# =============================================================================

# PIN to log into the control room UI (required — change it!)
ADMIN_PIN=change-me-please

# Where the server listens
HOST=0.0.0.0
PORT=3456

# BOT MODE: dry (paper trading, default & safe) or live (real orders — see
# README before flipping this!)
BOT_MODE=dry

# How often the genius scans (ms). 5000 = every 5 seconds.
SCAN_INTERVAL_MS=5000

# Where the SQLite database lives (relative to this folder)
DATA_DIR=data

# Where the built dashboard lives (leave as-is)
WEB_DIR=web/dist

# --- TELEGRAM NOTIFICATIONS (optional — leave empty to disable) -------------
# 1) Create a bot: talk to @BotFather on Telegram, send /newbot, copy the token.
# 2) Message your bot once, then get your chat id (e.g. via @userinfobot).
# The bot sends: entry alerts, take profit / stop loss, a daily P&L report and
# a morning briefing at 07:00 local time.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Timezone + hour for the daily P&L report / morning briefing (07:00 = 7 AM).
REPORT_TIMEZONE=Asia/Jakarta
DAILY_REPORT_HOUR=7

# --- COPY TRADE (optional — leave empty to disable) ---------------------------
# Mirror the BUY trades of a Polymarket wallet: paste the 0x… address shown on
# their profile page. Entries land in the same account; exits follow the bot's
# own 2× TP / 25% SL rules. First scan only starts following from that moment
# (no backfilling of old trades).
COPY_TRADE_WALLET=
COPY_MAX_OPEN=5
COPY_MAX_ORDER_USD=10
COPY_MIN_TRADE_USD=1
COPY_SCAN_INTERVAL_MS=30000

# --- LIVE MODE ONLY (leave empty while dry running) -------------------------
# Polymarket CLOB API keys — generate them at https://polymarket.com/profile
# after connecting your wallet. The bot NEVER trades live unless BOT_MODE=live
# AND all of these are filled in.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# Wallet that funds the Polymarket account (address where you deposit USDC)
POLY_WALLET_ADDRESS=
# Private key of that wallet (keep secret! never share this file)
POLY_PRIVATE_KEY=
# Hard cap per live order in USD — keep it tiny until you trust the bot
POLY_MAX_ORDER_USD=10
