# =============================================================================
# SUPER GENIUS BOT — VPS config
# Copy this file to `.env` (same folder) and edit. The server reads `.env` on
# startup. `cp env.example .env`
# =============================================================================

# PIN to log into the control room UI (required — change it!)
ADMIN_PIN=change-me-please

# Where the server listens
HOST=0.0.0.0
PORT=3456

# BOT MODE: dry (paper trading, default & safe) or live (real orders — see
# README before flipping this!)
BOT_MODE=dry

# How often the genius scans (ms). 5000 = every 5 seconds.
SCAN_INTERVAL_MS=5000

# Where the SQLite database lives (relative to this folder)
DATA_DIR=data

# Where the built dashboard lives (leave as-is)
WEB_DIR=web/dist

# --- LIVE MODE ONLY (leave empty while dry running) -------------------------
# Polymarket CLOB API keys — generate them at https://polymarket.com/profile
# after connecting your wallet. The bot NEVER trades live unless BOT_MODE=live
# AND all of these are filled in.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# Wallet that funds the Polymarket account (address where you deposit USDC)
POLY_WALLET_ADDRESS=
# Private key of that wallet (keep secret! never share this file)
POLY_PRIVATE_KEY=
# Hard cap per live order in USD — keep it tiny until you trust the bot
POLY_MAX_ORDER_USD=10
